# Copy this file to .env for local development. Values here are non-production
# examples; replace passwords before using the project outside your machine.

# Application
APP_ENV=local
LOG_LEVEL=INFO
RAW_DATA_DIR=./data/raw

# Weather warehouse (introduced in Stage 4)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=weather
WAREHOUSE_USER=weather
WAREHOUSE_PASSWORD=weather_local_only

# Airflow metadata database (introduced in Stage 10)
AIRFLOW_DATABASE=airflow
AIRFLOW_DATABASE_USER=airflow
AIRFLOW_DATABASE_PASSWORD=airflow_local_only

